#include "Generated/BuildVersion.xcconfig"

PRODUCT_NAME = HentaiPark
SDKROOT = auto
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
SUPPORTS_MACCATALYST = NO
IPHONEOS_DEPLOYMENT_TARGET = 15.0
MACOSX_DEPLOYMENT_TARGET = 12.0
TARGETED_DEVICE_FAMILY = 1,2
// VideoPlayer 在运行时装载 AVKit 的原生视图，Release 链接也必须保留该框架。
OTHER_LDFLAGS = $(inherited) -Wl,-needed_framework,AVKit
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE[sdk=iphone*] = App/iOS-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = HentaiPark
INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphone*] = YES
INFOPLIST_KEY_NSFaceIDUsageDescription[sdk=iphone*] = Authenticate to unlock HentaiPark.
INFOPLIST_KEY_NSPhotoLibraryAddUsageDescription = Save the selected page to your photo library.
INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphone*] = YES
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS[sdk=iphone*] = $(SRCROOT)/../../ios/Runner/Runner.entitlements
ENABLE_APP_SANDBOX[sdk=macosx*] = YES
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = $(SRCROOT)/App/macOS.entitlements
SWIFT_VERSION = 5.0
